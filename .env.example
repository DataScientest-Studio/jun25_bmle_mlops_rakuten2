# Configuration de la base de données PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=rakuten
DATABASE_USER=mlops
DATABASE_PASSWORD=mlops
LOAD_DB_DUMP=1

# Configuration MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rakuten_classification

# Configuration Airflow
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8081
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin123
AIRFLOW_EMAIL=admin@rakuten.com
AIRFLOW_SECRET_KEY=rakuten_secret_key_2025

# Configuration de l'API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Configuration Docker/Containers
# UID de l'utilisateur non-root utilisé dans les conteneurs (API et MLflow)
APPUSER_UID=1000

# Configuration des modèles
MODEL_DIR=models
DEFAULT_MODEL=lr_model_final.joblib

# Logs
LOG_LEVEL=INFO
